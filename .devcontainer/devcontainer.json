{
  "name": "EPIVUE web demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "kiosk/server.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt",
  "postAttachCommand": {
    "server": "python3 -m kiosk.server --web --host 0.0.0.0 --port 8080"
  },
  "portsAttributes": {
    "8080": { "label": "Web demo", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [8080]
}
