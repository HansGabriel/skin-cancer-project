{
  "name": "EPIVUE web demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "cloud/streamlit_app.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "pip3 install --user -r cloud/requirements.txt && pip3 install --user pytest",
  "postAttachCommand": {
    "server": "streamlit run cloud/streamlit_app.py --server.address 0.0.0.0"
  },
  "portsAttributes": {
    "8501": { "label": "Web demo", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [8501]
}
